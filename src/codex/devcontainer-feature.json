{
  "id": "codex",
  "version": "0.2.1",
  "name": "OpenAI Codex",
  "documentationURL": "https://github.com/awlsomealex/devcontainer-features/tree/main/src/codex",
  "description": "Installs the OpenAI Codex CLI and VSCode extension",
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils",
    "ghcr.io/awlsomealex/devcontainer-features/base"
  ],
  "options": {
    "version": {
      "type": "string",
      "proposals": [
        "latest"
      ],
      "default": "latest",
      "description": "Select version of OpenAI Codex, if not latest."
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt"
      ]
    }
  }
}
