{
  "id": "lazygit",
  "version": "0.1.3",
  "name": "LazyGit",
  "documentationURL": "https://github.com/awlsomealex/devcontainer-features/tree/main/src/lazygit",
  "description": "Installs the LazyGit terminal UI for Git.",
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils",
    "ghcr.io/awlsomealex/devcontainer-features/base"
  ],
  "options": {
    "version": {
      "type": "string",
      "proposals": [
        "latest"
      ],
      "default": "latest",
      "description": "Select the LazyGit version to install."
    }
  }
}